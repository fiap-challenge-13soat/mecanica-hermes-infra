# Exemplo de arquivo de variáveis do Terraform para Cognito
# Copie este arquivo para terraform.tfvars e preencha com os valores corretos

# Nome do projeto (padrão: mechermes)
project_name = "mechermes"

# Ambiente (hml ou prd)
environment = "hml"

# Prefixo do domínio Cognito (deve ser único globalmente)
# Para importar recursos existentes, use o mesmo valor do Cognito atual
cognito_domain_prefix = "<COGNITO_DOMAIN_PREFIX>"

# Nome do User Pool (opcional)
# Se não fornecido, será usado: mechermes-{environment}-userpool
# Para importar recursos existentes, use o mesmo nome do User Pool atual
user_pool_name = "<USER_POOL_NAME>"

# Identificador do Resource Server (padrão: mechermes)
resource_server_identifier = "mechermes"

# Nome do Resource Server
resource_server_name = "Mecanica Hermes API"
